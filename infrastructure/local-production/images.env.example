POLLYCAR_OTEL_COLLECTOR_IMAGE_DIGEST=docker.io/otel/opentelemetry-collector-contrib@sha256:REPLACE_WITH_APPROVED_DIGEST
POLLYCAR_CADDY_IMAGE_DIGEST=docker.io/library/caddy@sha256:REPLACE_WITH_APPROVED_DIGEST
