  "radius": {
    "small": { "$value": "10px", "$type": "dimension" },
    "medium": { "$value": "16px", "$type": "dimension" },
    "panel": { "$value": "24px", "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
