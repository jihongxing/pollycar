    "touchTarget": { "$value": "44px", "$type": "dimension" },
    "button": { "$value": "56px", "$type": "dimension" },
    "input": { "$value": "52px", "$type": "dimension" },
    "icon": { "$value": "22px", "$type": "dimension" }
