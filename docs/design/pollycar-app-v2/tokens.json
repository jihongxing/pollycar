{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "pollycar-app-v2-candidate",
  "description": "PollyCar App v2 候选设计令牌，供 Penpot 变量和 App 代码映射使用。",
  "color": {
    "ink": {
      "950": { "$value": "#13243A", "$type": "color" },
      "700": { "$value": "#40546D", "$type": "color" },
      "500": { "$value": "#718096", "$type": "color" }
    },
    "paper": {
      "50": { "$value": "#FFFDF8", "$type": "color" },
      "100": { "$value": "#F6F3EC", "$type": "color" },
      "200": { "$value": "#EAE7DF", "$type": "color" }
    },
    "lamp": {
      "500": { "$value": "#E3A34A", "$type": "color" },
      "600": { "$value": "#C88932", "$type": "color" }
    },
    "passenger": {
      "500": { "$value": "#3D8C92", "$type": "color" },
      "100": { "$value": "#E3F0EF", "$type": "color" }
    },
    "owner": {
      "500": { "$value": "#4B72B5", "$type": "color" },
      "100": { "$value": "#E6EDF8", "$type": "color" }
    },
    "safety": {
      "500": { "$value": "#B75D50", "$type": "color" },
      "100": { "$value": "#F6E7E3", "$type": "color" }
    },
    "mist": {
      "300": { "$value": "#D9D7D0", "$type": "color" },
      "500": { "$value": "#AAA9A2", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "Inter, Noto Sans SC, system-ui, sans-serif", "$type": "fontFamily" },
      "display": { "$value": "Noto Serif SC, Songti SC, serif", "$type": "fontFamily" }
    },
    "size": {
      "caption": { "$value": "12px", "$type": "dimension" },
      "body": { "$value": "15px", "$type": "dimension" },
      "bodyLarge": { "$value": "17px", "$type": "dimension" },
      "title": { "$value": "24px", "$type": "dimension" },
      "display": { "$value": "32px", "$type": "dimension" }
    },
    "weight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium": { "$value": "500", "$type": "fontWeight" },
      "bold": { "$value": "700", "$type": "fontWeight" }
    }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" }
