{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pollycar.local/spec/meta/eligibility-states.schema.json",
  "title": "弹性资格状态规范",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "spec_id", "language", "production_enabled", "status", "source_documents", "initial_state", "flex_quota_active_state", "states", "transitions", "concurrency_priority", "error_codes"],
  "properties": {
    "spec_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "spec_id": {"const": "pollycar.flex-eligibility.states"},
    "language": {"const": "zh-CN"},
    "production_enabled": {"const": false},
    "status": {"enum": ["draft", "review", "approved", "rejected", "superseded"]},
    "source_documents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^docs/.+\\.md$"}},
    "initial_state": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "flex_quota_active_state": {"const": "active"},
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "terminal", "flex_quota_enabled"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "terminal": {"type": "boolean"},
          "flex_quota_enabled": {"type": "boolean"}
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "event", "actors", "guards"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "from": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "to": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "event": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "actors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
          "guards": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
        }
      }
    },
    "concurrency_priority": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
    "error_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ELIGIBILITY_[A-Z0-9_]+$"}}
  }
}
