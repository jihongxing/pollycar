{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pollycar.local/spec/meta/admin-trip-case-management-scenarios.schema.json",
  "title": "行程客服安全验收场景",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "spec_id", "language", "production_enabled", "status", "source_document", "scenarios"],
  "properties": {
    "spec_version": {"const": "1.0"},
    "spec_id": {"const": "pollycar.tests.admin-trip-case-management-scenarios"},
    "language": {"const": "zh-CN"},
    "production_enabled": {"const": false},
    "status": {"const": "approved"},
    "source_document": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "title", "initial_state", "actor", "command", "expected_events", "expected_state", "expected_error"],
        "properties": {
          "id": {"type": "string", "pattern": "^ADMIN-TCS-[0-9]{3}$"},
          "category": {"enum": ["trip_operations", "support_case", "safety_case", "emergency", "evidence", "cross_organization", "recovery", "authorization", "boundary", "separation_of_duties", "concurrency", "audit", "feature_gate"]},
          "title": {"type": "string", "minLength": 1},
          "initial_state": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "actor": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "command": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
          "expected_events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
          "expected_state": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "expected_error": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]+$"}
        }
      }
    }
  }
}

