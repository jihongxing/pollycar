{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pollycar.local/spec/meta/mobility-scenarios.schema.json",
  "title": "核心出行验收场景规范",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "spec_id", "language", "production_enabled", "status", "source_document", "scenarios"],
  "properties": {
    "spec_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "spec_id": {"const": "pollycar.tests.mobility-scenarios"},
    "language": {"const": "zh-CN"},
    "production_enabled": {"const": false},
    "status": {"enum": ["draft", "review", "approved", "rejected", "superseded"]},
    "source_document": {"type": "string"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "initial_state", "actor", "command", "expected_events", "expected_state", "expected_error", "audit", "classification", "release_blocking"],
        "properties": {
          "id": {"type": "string", "pattern": "^MOB-[0-9]{3}$"},
          "name": {"type": "string", "minLength": 1},
          "category": {"enum": ["account_session", "driver_liveness_verification", "driver_availability", "dispatch_offer", "trip_fulfillment", "trip_scheduling", "trip_cancellation", "trip_completion", "driver_orders", "driver_finance", "trip_chat", "message_center", "trust_profile", "trip_rating", "fairness_monitoring", "data_lifecycle", "map_place_search", "map_reverse_geocode", "map_route", "vehicle_location_stream", "map_data_lifecycle"]},
          "initial_state": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "actor": {"enum": ["passenger", "driver"]},
          "command": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
          "expected_events": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
          "expected_state": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "expected_error": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]+$"},
          "audit": {"enum": ["none", "standard", "sensitive", "strict"]},
          "classification": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
          "release_blocking": {"type": "boolean"}
        }
      }
    }
  }
}
