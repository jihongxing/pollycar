{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pollycar.local/spec/meta/finance-operations.schema.json",
  "title": "运营控制台资金运营契约",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "spec_id", "language", "status", "production_enabled", "source_document", "decision", "design_approval", "feature_gate", "authoritative_sources", "admin_owned_records", "functional_roles", "organization_scope", "money", "modules", "write_entrypoint", "allocation_settlement", "driver_payout", "refund_reversal", "reconciliation", "business_day_close", "ledger_query", "unknown_result_recovery", "separation_of_duties", "audit", "productized_admin_api", "implementation_gate"],
  "properties": {
    "spec_version": {"const": "1.0"},
    "spec_id": {"const": "pollycar.admin.finance-operations"},
    "language": {"const": "zh-CN"},
    "status": {"const": "approved"},
    "production_enabled": {"const": false},
    "source_document": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "design_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "approved_on", "implementation_approved", "implementation_approval_required", "synthetic_only", "internal_sandbox_only"],
      "properties": {
        "approved": {"const": true},
        "approved_on": {"const": "2026-07-14"},
        "implementation_approved": {"const": true},
        "implementation_approval_required": {"const": true},
        "synthetic_only": {"const": true},
        "internal_sandbox_only": {"const": true}
      }
    },
    "feature_gate": {"type": "object"},
    "authoritative_sources": {"type": "object"},
    "admin_owned_records": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
    "functional_roles": {"type": "object"},
    "organization_scope": {"type": "object"},
    "money": {"type": "object"},
    "modules": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "object"}},
    "write_entrypoint": {"type": "object"},
    "allocation_settlement": {"type": "object"},
    "driver_payout": {"type": "object"},
    "refund_reversal": {"type": "object"},
    "reconciliation": {"type": "object"},
    "business_day_close": {"type": "object"},
    "ledger_query": {"type": "object"},
    "unknown_result_recovery": {"type": "object"},
    "separation_of_duties": {"type": "object"},
    "audit": {"type": "object"},
    "productized_admin_api": {"type": "object"},
    "implementation_gate": {"type": "object"}
  }
}
