{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pollycar.local/spec/meta/data-classification.schema.json",
  "title": "数据分类规范",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "spec_id", "language", "production_enabled", "status", "source_document", "levels", "fields", "combination_rule", "event_payload_rule"],
  "properties": {
    "spec_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "spec_id": {"const": "pollycar.security.data-classification"},
    "language": {"const": "zh-CN"},
    "production_enabled": {"const": false},
    "status": {"enum": ["draft", "review", "approved", "rejected", "superseded"]},
    "source_document": {"type": "string"},
    "levels": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "name", "authentication_required", "encryption_in_transit", "encryption_at_rest", "audit", "non_production", "logging"],
        "properties": {
          "id": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
          "name": {"type": "string"},
          "authentication_required": {"type": "boolean"},
          "strong_authentication_required": {"type": "boolean"},
          "encryption_in_transit": {"type": "boolean"},
          "encryption_at_rest": {"type": "string"},
          "audit": {"type": "string"},
          "non_production": {"type": "string"},
          "logging": {"type": "string"}
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "classification"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
          "classification": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
          "platform_storage": {"type": "string"},
          "platform_logging": {"type": "string"}
        }
      }
    },
    "combination_rule": {"const": "use_highest_classification"},
    "event_payload_rule": {"const": "references_and_minimum_summary_only"}
  }
}
