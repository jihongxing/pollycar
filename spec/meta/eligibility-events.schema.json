{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pollycar.local/spec/meta/eligibility-events.schema.json",
  "title": "弹性资格领域事件规范",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "spec_id", "language", "production_enabled", "status", "source_document", "event_envelope", "events", "forbidden_payload_fields"],
  "properties": {
    "spec_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "spec_id": {"const": "pollycar.flex-eligibility.events"},
    "language": {"const": "zh-CN"},
    "production_enabled": {"const": false},
    "status": {"enum": ["draft", "review", "approved", "rejected", "superseded"]},
    "source_document": {"type": "string", "pattern": "^docs/.+\\.md$"},
    "event_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields"],
      "properties": {
        "required_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "aggregate", "classification", "idempotency_required"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "aggregate": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "classification": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
          "idempotency_required": {"type": "boolean"}
        }
      }
    },
    "forbidden_payload_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
  }
}
