{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pollycar.local/spec/meta/role-access-matrix.schema.json",
  "title": "运营后台三级授权模型矩阵",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "spec_id", "language", "production_enabled", "status", "source_document", "decision", "design_approval", "feature_gate", "authorization", "authorization_levels", "organization_scopes", "business_capabilities", "legacy_role_migration", "navigation", "route_policy", "separation_of_duties", "field_profiles", "export_profiles", "bulk_actions", "implementation_gate"],
  "properties": {
    "spec_version": {"const": "2.0"},
    "spec_id": {"const": "pollycar.admin.role-access-matrix"},
    "language": {"const": "zh-CN"},
    "production_enabled": {"const": false},
    "status": {"const": "design_frozen"},
    "source_document": {"type": "string"},
    "decision": {"type": "string"},
    "design_approval": {"type": "object"},
    "feature_gate": {"type": "object"},
    "authorization": {"type": "object"},
    "authorization_levels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "object", "required": ["id", "name", "organizations", "maximum_actions"]}
    },
    "organization_scopes": {"type": "object"},
    "business_capabilities": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"type": "object", "required": ["id", "menus", "minimum_level"]}
    },
    "legacy_role_migration": {"type": "object", "required": ["runtime_compatibility", "authorization_by_legacy_role_forbidden", "mappings"]},
    "navigation": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"type": "object", "required": ["id", "route_prefix"]}
    },
    "route_policy": {"type": "object"},
    "separation_of_duties": {"type": "object"},
    "field_profiles": {"type": "object", "minProperties": 6},
    "export_profiles": {"type": "object", "minProperties": 4},
    "bulk_actions": {"type": "object"},
    "implementation_gate": {"type": "object"}
  }
}
