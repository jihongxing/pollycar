{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pollycar.local/spec/meta/error-codes.schema.json",
  "title": "API 错误码规范",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "spec_id", "language", "production_enabled", "status", "source_document", "response_schema", "errors"],
  "properties": {
    "spec_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "spec_id": {"const": "pollycar.api.error-codes"},
    "language": {"const": "zh-CN"},
    "production_enabled": {"const": false},
    "status": {"enum": ["draft", "review", "approved", "rejected", "superseded"]},
    "source_document": {"type": "string"},
    "response_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields"],
      "properties": {
        "required_fields": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "http_status", "message", "retryable", "disclosure", "audit", "client_action"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "http_status": {"type": "integer", "minimum": 400, "maximum": 599},
          "message": {"type": "string", "minLength": 1},
          "retryable": {"type": "boolean"},
          "disclosure": {"enum": ["public", "limited", "generic", "internal_only"]},
          "audit": {"enum": ["none", "standard", "sensitive", "strict"]},
          "client_action": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    }
  }
}
