{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "spec_id",
    "language",
    "status",
    "production_enabled",
    "synthetic_data_only",
    "feature_gate",
    "primary_operator",
    "allocation",
    "settlement",
    "payout",
    "early_settlement",
    "fund_cases",
    "balance_authority",
    "database",
    "implementation"
  ],
  "properties": {
    "spec_version": { "const": "1.0" },
    "spec_id": { "const": "pollycar.finance.operator-funds" },
    "language": { "const": "zh-CN" },
    "status": { "const": "approved_for_internal_sandbox" },
    "production_enabled": { "const": false },
    "synthetic_data_only": { "const": true },
    "feature_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "default_enabled", "required_context", "ledger_required", "reconciliation_required", "real_operator_allowed", "real_settlement_allowed", "real_payout_allowed"],
      "properties": {
        "id": { "const": "synthetic_operator_funds" },
        "default_enabled": { "const": false },
        "required_context": { "const": "internal_sandbox" },
        "ledger_required": { "const": true },
        "reconciliation_required": { "const": true },
        "real_operator_allowed": { "const": false },
        "real_settlement_allowed": { "const": false },
        "real_payout_allowed": { "const": false }
      }
    },
    "primary_operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "uniqueness_scope", "one_active_membership_required", "trip_operator_snapshot_immutable", "historical_reassignment_allowed"],
      "properties": {
        "table": { "const": "pollycar_finance.driver_operator_memberships" },
        "uniqueness_scope": { "const": ["driver_account_id", "city_code", "vehicle_id"] },
