      "properties": {
        "table": { "const": "pollycar_finance.financial_allocations" },
        "rule_version": { "const": "allocation-15-45-40-v1" },
        "platform_rate_bps": { "const": 1500 },
        "operator_rate_bps": { "const": 4500 },
        "driver_rate_bps": { "const": 4000 },
        "total_rate_bps": { "const": 10000 },
        "platform_rounding": { "const": "floor" },
        "operator_rounding": { "const": "floor" },
        "remainder_recipient": { "const": "driver" },
        "amount_conservation_required": { "const": true },
        "ledger_transaction_type": { "const": "ALLOCATION_15_45_40" },
        "reconciliation_gate_required": { "const": true }
        ,"database_reconciliation_gate_required": { "const": true }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_table", "item_table", "amount_formula", "server_calculated_only", "allocation_once_only", "prepared_and_reviewed_by_must_differ", "reconciliation_gate_required", "database_reconciliation_gate_required"],
      "properties": {
        "batch_table": { "const": "pollycar_finance.operator_settlement_batches" },
        "item_table": { "const": "pollycar_finance.operator_settlement_batch_items" },
        "amount_formula": { "const": "operator_share_minor_plus_driver_share_minor" },
        "server_calculated_only": { "const": true },
        "allocation_once_only": { "const": true },
        "prepared_and_reviewed_by_must_differ": { "const": true },
        "reconciliation_gate_required": { "const": true }
        ,"database_reconciliation_gate_required": { "const": true }
      }
    },
    "payout": {
