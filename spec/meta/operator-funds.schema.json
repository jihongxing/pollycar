    "balance_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritative_source", "projection_source", "operator_balance_table_allowed", "driver_balance_table_allowed", "wallet_table_allowed", "direct_balance_mutation_allowed"],
      "properties": {
        "authoritative_source": { "const": "pollycar_finance.ledger_entries" },
        "projection_source": { "const": "pollycar_finance.ledger_balance_projections" },
        "operator_balance_table_allowed": { "const": false },
        "driver_balance_table_allowed": { "const": false },
        "wallet_table_allowed": { "const": false },
        "direct_balance_mutation_allowed": { "const": false }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_entrypoint", "security_definer_required", "runtime_direct_write_allowed", "command_function_bypass_allowed", "migration_file"],
      "properties": {
        "command_entrypoint": { "const": "pollycar_finance.apply_operator_funds_command(p_command jsonb)" },
        "security_definer_required": { "const": true },
        "runtime_direct_write_allowed": { "const": false },
        "command_function_bypass_allowed": { "const": false },
        "migration_file": { "const": "apps/server/migrations/0009_operator_funds_orchestration.sql" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_8_status", "service_file", "repository_file", "integration_test_file", "proof_command", "result", "app_or_api_integration_allowed", "real_data_allowed", "production_enablement_allowed"],
      "properties": {
        "stage_8_status": { "const": "completed" },
        "service_file": { "const": "apps/server/src/application/synthetic-operator-funds-service.ts" },
        "repository_file": { "const": "apps/server/src/persistence/postgres-operator-funds-repository.ts" },
        "integration_test_file": { "const": "apps/server/src/persistence/ledger-stage8-operator-funds.integration.test.ts" },
        "proof_command": { "const": "pnpm test:ledger:stage8" },
        "result": { "const": "16_passed" },
        "app_or_api_integration_allowed": { "const": false },
        "real_data_allowed": { "const": false },
        "production_enablement_allowed": { "const": false }
      }
    }
