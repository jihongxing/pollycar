        "item_table": { "const": "pollycar_finance.driver_payout_batch_items" },
        "standard_cycle": { "const": "T+1" },
        "previous_business_date_allocations_only": { "const": true },
        "batch_generation_deadline": { "const": "12:00" },
        "review_and_submit_deadline": { "const": "18:00" },
        "prepared_and_reviewed_by_must_differ": { "const": true },
        "allocation_once_only": { "const": true },
        "request_transaction_type": { "const": "DRIVER_PAYOUT_REQUESTED" },
        "completed_transaction_type": { "const": "DRIVER_PAYOUT_COMPLETED" },
        "payout_fee_borne_by": { "const": "operator" },
        "payout_fee_reduces_driver_payable": { "const": false },
        "reconciliation_gate_required": { "const": true }
        ,"database_reconciliation_gate_required": { "const": true }
      }
    },
    "early_settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "error_code", "wallet_created", "driver_fee_allowed"],
      "properties": {
        "enabled": { "const": false },
        "error_code": { "const": "DRIVER_EARLY_SETTLEMENT_DISABLED" },
        "wallet_created": { "const": false },
        "driver_fee_allowed": { "const": false }
      }
    },
    "fund_cases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "types", "evidence_reference_required", "balance_source_allowed"],
      "properties": {
        "table": { "const": "pollycar_finance.operator_fund_cases" },
        "types": { "const": ["settlement_blocked", "payout_overdue", "payout_unknown", "funds_insufficient", "refund_recovery"] },
        "evidence_reference_required": { "const": true },
        "balance_source_allowed": { "const": false }
      }
