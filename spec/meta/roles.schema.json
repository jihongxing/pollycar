{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pollycar.local/spec/meta/roles.schema.json",
  "title": "安全角色规范",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "spec_id", "language", "production_enabled", "status", "source_document", "roles", "constraints"],
  "properties": {
    "spec_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "spec_id": {"const": "pollycar.security.roles"},
    "language": {"const": "zh-CN"},
    "production_enabled": {"const": false},
    "status": {"enum": ["draft", "review", "approved", "rejected", "superseded"]},
    "source_document": {"type": "string"},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "category": {"enum": ["user", "staff", "system"]}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared_accounts_forbidden", "self_approval_forbidden", "temporary_access_default_ttl", "emergency_access_review_sla"],
      "properties": {
        "shared_accounts_forbidden": {"const": true},
        "self_approval_forbidden": {"const": true},
        "temporary_access_default_ttl": {"type": "string", "pattern": "^PT[0-9]+[HMS]$"},
        "emergency_access_review_sla": {"type": "string", "pattern": "^PT[0-9]+[HMS]$"}
      }
    }
  }
}
