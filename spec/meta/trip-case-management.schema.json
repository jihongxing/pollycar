{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pollycar.local/spec/meta/trip-case-management.schema.json",
  "title": "行程客服安全管理契约",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "spec_id", "language", "status", "production_enabled", "source_document", "decision", "implementation_approval", "feature_gates", "authoritative_sources", "owned_records", "trip_operations", "support_cases", "safety_collaboration", "cross_organization_visibility", "evidence_access", "unknown_result_recovery", "prohibited"],
  "properties": {
    "spec_version": {"const": "1.0"},
    "spec_id": {"const": "pollycar.admin.trip-case-management"},
    "language": {"const": "zh-CN"},
    "status": {"const": "approved"},
    "production_enabled": {"const": false},
    "source_document": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "implementation_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "approved_on", "synthetic_only", "internal_sandbox_only", "feature_gate_default_enabled", "production_enable_forbidden", "real_data_forbidden"],
      "properties": {
        "approved": {"const": true},
        "approved_on": {"const": "2026-07-14"},
        "synthetic_only": {"const": true},
        "internal_sandbox_only": {"const": true},
        "feature_gate_default_enabled": {"const": false},
        "production_enable_forbidden": {"const": true},
        "real_data_forbidden": {"const": true}
      }
    },
    "feature_gates": {"type": "object", "required": []},
    "authoritative_sources": {"type": "object", "required": []},
    "owned_records": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string"}},
    "trip_operations": {"type": "object", "required": []},
    "support_cases": {"type": "object", "required": []},
    "safety_collaboration": {"type": "object", "required": []},
    "cross_organization_visibility": {"type": "object", "required": []},
    "evidence_access": {"type": "object", "required": []},
    "unknown_result_recovery": {"type": "object", "required": []},
    "prohibited": {"type": "object", "required": []}
  }
}
