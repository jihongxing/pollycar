# 本地沙箱默认不需要环境变量；只在端口冲突或测试隔离时覆盖。
POLLYCAR_LOCAL_SANDBOX_SERVER_PORT=4321
POLLYCAR_LOCAL_SANDBOX_ADMIN_PORT=4173
POLLYCAR_LOCAL_SANDBOX_APP_PORT=8181

# 本地沙箱状态与来源。
POLLYCAR_EXECUTIVE_STATE_DIR=.codex-runtime/admin-executive-dashboard
POLLYCAR_SANDBOX_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:8181
