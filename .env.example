# Local environment example.
# Copy to .env and fill local values only. Never commit real secrets.

APP_ENV=local
APP_NAME=PollyCar
APP_PORT=3000

# Database
DATABASE_URL=

# Auth / secrets
APP_SECRET=

# External services
EXTERNAL_API_BASE_URL=
EXTERNAL_API_KEY=

# Observability
LOG_LEVEL=info

# 运营控制台阶段一多组织后台底座，前后端必须同时显式开启。
POLLYCAR_SYNTHETIC_ADMIN_MULTI_ORGANIZATION=false
POLLYCAR_SYNTHETIC_ADMIN_AUTHENTICATION=false
POLLYCAR_SYNTHETIC_ADMIN_ROLE_ACCESS_MATRIX=false
VITE_SYNTHETIC_ADMIN_MULTI_ORGANIZATION=false
VITE_SYNTHETIC_ADMIN_AUTHENTICATION=false
VITE_SYNTHETIC_ADMIN_ROLE_ACCESS_MATRIX=false
POLLYCAR_SYNTHETIC_ADMIN_OPERATOR_MANAGEMENT=false
POLLYCAR_SYNTHETIC_ADMIN_DRIVER_VEHICLE=false
POLLYCAR_SYNTHETIC_ADMIN_TRIP_OPERATIONS=false
POLLYCAR_SYNTHETIC_ADMIN_CASE_MANAGEMENT=false
POLLYCAR_SYNTHETIC_ADMIN_FINANCE_OPERATIONS=false
POLLYCAR_SYNTHETIC_ADMIN_EXECUTIVE_DASHBOARD=false
POLLYCAR_SYNTHETIC_ADMIN_AUDIT_SYSTEM=false
POLLYCAR_SYNTHETIC_ADMIN_DATA_REPORTS=false
POLLYCAR_SYNTHETIC_ADMIN_ORGANIZATION_ACCOUNTS=false
VITE_SYNTHETIC_ADMIN_OPERATOR_MANAGEMENT=false
VITE_SYNTHETIC_ADMIN_DRIVER_VEHICLE=false
VITE_SYNTHETIC_ADMIN_TRIP_OPERATIONS=false
VITE_SYNTHETIC_ADMIN_CASE_MANAGEMENT=false
VITE_SYNTHETIC_ADMIN_FINANCE_OPERATIONS=false
VITE_SYNTHETIC_ADMIN_EXECUTIVE_DASHBOARD=false
VITE_SYNTHETIC_ADMIN_AUDIT_SYSTEM=false
VITE_SYNTHETIC_ADMIN_DATA_REPORTS=false
POLLYCAR_EXECUTIVE_STATE_DIR=.codex-runtime/admin-executive-dashboard
POLLYCAR_SANDBOX_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
