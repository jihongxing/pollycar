{
  "name": "pollycar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev:local": "powershell.exe -NoProfile -File scripts/dev/start-local-sandbox.ps1",
    "dev:local:restart": "powershell.exe -NoProfile -File scripts/dev/start-local-sandbox.ps1 -Restart",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:configuration-governance": "powershell.exe -NoProfile -File scripts/test/check-configuration-governance.ps1",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @pollycar/app build && pnpm --filter @pollycar/admin build && pnpm exec playwright test",
    "test:e2e:a11y": "pnpm --filter @pollycar/app build && pnpm --filter @pollycar/admin build && pnpm exec playwright test tests/e2e/app-accessibility.spec.ts",
    "test:e2e:visual": "pnpm --filter @pollycar/app build && pnpm exec playwright test tests/e2e/app-visual-regression.spec.ts",
    "test:device:android": "powershell.exe -NoProfile -File scripts/test/run-device-qa.ps1 -Platform android -ProfileId android-standard -Journey first_time_user -Flow core -TesterId local-operator -BuildId local",
    "test:device:ios": "powershell.exe -NoProfile -File scripts/test/run-device-qa.ps1 -Platform ios -ProfileId ios-standard -Journey first_time_user -Flow core -TesterId local-operator -BuildId local",
    "test:device:summary": "powershell.exe -NoProfile -File scripts/test/summarize-device-qa.ps1",
    "test:manual:browser-mobile": "node scripts/test/run-browser-mobile-acceptance.mjs",
    "test:manual:android-emulator-web": "node scripts/test/run-android-emulator-web-acceptance.mjs",
    "test:scenarios": "pnpm --filter @pollycar/domain test:scenarios",
    "test:ledger:stage3": "powershell.exe -NoProfile -File scripts/test/run-ledger-stage3-proof.ps1",
    "test:ledger:stage4": "powershell.exe -NoProfile -File scripts/test/run-ledger-stage4-kernel.ps1",
    "test:ledger:stage5": "powershell.exe -NoProfile -File scripts/test/run-ledger-stage5-resilience.ps1",
    "test:ledger:stage6": "powershell.exe -NoProfile -File scripts/test/run-ledger-stage6-templates.ps1",
    "test:ledger:stage7": "powershell.exe -NoProfile -File scripts/test/run-ledger-stage7-reconciliation.ps1",
    "test:ledger:stage8": "powershell.exe -NoProfile -File scripts/test/run-ledger-stage8-operator-funds.ps1",
    "build": "pnpm -r --if-present build"
    ,
    "build:app:sandbox": "pnpm --filter @pollycar/app build:sandbox",
    "build:app:demo": "pnpm --filter @pollycar/app build:demo",
    "build:app:production": "pnpm --filter @pollycar/app build:production",
    "build:app:android:production": "pnpm --filter @pollycar/app android:production",
    "build:app:ios:production": "pnpm --filter @pollycar/app ios:production",
    "build:app:eas:production": "pnpm --filter @pollycar/app eas:production",
    "check:app:production-release": "pnpm --filter @pollycar/app ci:production:gate"
    ,
    "check:build-config": "node scripts/build/check-build-configuration.mjs"
    ,
    "infra:shared-preproduction:plan": "node scripts/infra/run-shared-preproduction-iac.mjs plan",
    "infra:shared-preproduction:apply": "node scripts/infra/run-shared-preproduction-iac.mjs apply",
    "check:shared-preproduction:iac": "powershell.exe -NoProfile -File scripts/test/check-shared-preproduction-iac.ps1"
    ,
    "supply-chain:report": "node scripts/infra/generate-container-supply-chain-report.mjs",
    "check:supply-chain": "powershell.exe -NoProfile -File scripts/test/check-container-supply-chain.ps1"
    ,
    "operational-drill:template": "node scripts/infra/run-operational-drill-evidence.mjs template",
    "operational-drill:validate": "node scripts/infra/run-operational-drill-evidence.mjs validate",
    "check:operational-drill": "powershell.exe -NoProfile -File scripts/test/check-operational-drill-evidence.ps1"
    ,
    "production-candidate:report": "node scripts/infra/generate-production-candidate-readiness.mjs",
    "check:production-candidate": "powershell.exe -NoProfile -File scripts/test/check-production-candidate-readiness.ps1"
    ,
    "sbom:generate": "node scripts/infra/generate-cyclonedx-sbom.mjs",
    "test:postgres:integration": "pnpm --filter @pollycar/server test:postgres-dispatch && pnpm --filter @pollycar/server test:postgres-ledger-prototype && pnpm --filter @pollycar/server test:postgres-ledger-kernel && pnpm --filter @pollycar/server test:postgres-ledger-resilience && pnpm --filter @pollycar/server test:postgres-ledger-templates && pnpm --filter @pollycar/server test:postgres-reconciliation && pnpm --filter @pollycar/server test:postgres-operator-funds"
  },
  "devDependencies": {
    "@pollycar/configuration": "workspace:*",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "@types/node": "22.19.1",
    "serve": "14.2.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.8",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "postcss": "8.5.18"
    }
  }
}
